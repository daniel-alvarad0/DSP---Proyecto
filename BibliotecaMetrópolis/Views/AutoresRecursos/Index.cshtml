@model IEnumerable<BibliotecaMetrópolis.AutoresRecursos>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<h2>Autores Recursos</h2>

<p>
    @Html.ActionLink("Registrar Autor", "Create")
</p>


<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.IdRecurso)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TipoRecurso)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.EsPrincipal)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Autor.Nombre)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.IdRecurso)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TipoRecurso)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.EsPrincipal)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Autor.Nombre)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.IdRecAutor }) |
            @Html.ActionLink("Detalles", "Details", new { id=item.IdRecAutor }) |
            @Html.ActionLink("Eliminar", "Delete", new { id=item.IdRecAutor })
        </td>
    </tr>
}

</table>
