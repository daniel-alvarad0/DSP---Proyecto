@model BibliotecaMetrópolis.AutoresRecursos

@{
    ViewBag.Title = "Eliminar";
}

<h2>Eliminar</h2>

<h3>¿Estás seguro de que deseas eliminar esto?</h3>
<div>
    <h4>Autores Recursos</h4>
    <hr />
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Campo</th>
                <th>Valor</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.IdRecurso)
                </td>
                <td>
                    @Html.DisplayFor(model => model.IdRecurso)
                </td>
            </tr>
            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.TipoRecurso)
                </td>
                <td>
                    @Html.DisplayFor(model => model.TipoRecurso)
                </td>
            </tr>
            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.EsPrincipal)
                </td>
                <td>
                    @Html.DisplayFor(model => model.EsPrincipal)
                </td>
            </tr>
            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.Autor.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(model => model.Autor.Nombre)
                </td>
            </tr>
        </tbody>
    </table>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Borrar" class="btn btn-danger" /> |
            @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    }
</div>
