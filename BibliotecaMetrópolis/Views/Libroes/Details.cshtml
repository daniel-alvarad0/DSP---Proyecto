@model BibliotecaMetrópolis.Libro

@{
    ViewBag.Title = "Detalles";
}

<h2>Detalles</h2>

<div>
    <h4>Libro</h4>
    <hr />
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Campo</th>
                <th>Valor</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.Titulo)
                </td>
                <td>
                    @Html.DisplayFor(model => model.Titulo)
                </td>
            </tr>
            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.AnnoPublic)
                </td>
                <td>
                    @Html.DisplayFor(model => model.AnnoPublic)
                </td>
            </tr>
            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.Edicion)
                </td>
                <td>
                    @Html.DisplayFor(model => model.Edicion)
                </td>
            </tr>
            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.PalabraBusqueda)
                </td>
                <td>
                    @Html.DisplayFor(model => model.PalabraBusqueda)
                </td>
            </tr>
            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.Editorial.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(model => model.Editorial.Nombre)
                </td>
            </tr>
            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.Pais.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(model => model.Pais.Nombre)
                </td>
            </tr>
        </tbody>
    </table>
</div>

<p>
    @Html.ActionLink("Editar", "Edit", new { id = Model.IdLibro }, new { @class = "btn btn-primary" }) |
    @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary" })
</p>
